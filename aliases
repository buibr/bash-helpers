# some more ls aliases
alias ll='ls -alFhn'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# sail
alias sa='sail artisan '
alias sc='sail composer '
alias st='sail test '
alias sd='sail debug '
alias snpm='sail npm'
alias sa-mfs='sail artisan migrate:fresh --seed'
alias sa-rl='sail artisan route:list '
alias sa-rln='sail artisan route:list --name '
