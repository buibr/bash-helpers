alias sa-tf='sail artisan test --filter '

# midx
alias mx_backup='sail exec  mariadb-backup bash midx/scripts/backup.sh'
alias mx_deploy='git pull && mx_deploy_php && mx_deploy_js'
alias mx_deploy_force='git pull && mx_down_remove && mx_deploy_php && mx_deploy_js'
alias mx_deploy_js='sail up -d && rm -rf ./public/assets/*.* && rm -rf ./public/hot && sail npm i && sail npm run build-only'
alias mx_deploy_php='sail up -d && sail artisan clear && sail artisan optimize:clear && sail composer install -o --ignore-platform-reqs && sail artisan migrate --force --no-interaction && sail artisan optimize'
alias mx_down='sail down'
alias mx_down_remove='sail down --rmi local -v'
alias mx_restore='sail exec  mariadb-backup bash midx/scripts/restore.sh'

# debuging
