#!/usr/bin/env bash
# bi: Find Android SDKs (adb), pick one and export ANDROID_HOME
# bi-arg: @dir
# Scan the system for Android SDKs (adb), let you pick one, and write a managed
# block into ~/.me/exports.local so adb is available in every terminal.
# Usage: bi-adb-fix [path-to-sdk-or-adb]   (no arg: scan and choose)
set -euo pipefail

EXPORTS="$HOME/.me/exports.local"   # machine-specific, not in git; loaded by ~/.me/exports
BEGIN="# >>> bi-adb-fix >>>"
END="# <<< bi-adb-fix <<<"

# Resolve an SDK root from a path that may be the SDK, platform-tools, or adb itself.
sdk_root_of() {
    local p="$1"
    [ -e "$p" ] || return 1
    [ -L "$p" ] && p=$(readlink -f "$p")   # e.g. /usr/bin/adb -> real sdk
    [ -f "$p" ] && p=$(dirname "$p")
    [ "$(basename "$p")" = "platform-tools" ] && p=$(dirname "$p")
    [ -x "$p/platform-tools/adb" ] && echo "$p"
}

if [ $# -gt 0 ]; then
    SDK=$(sdk_root_of "$1") || { echo "No adb found at: $1" >&2; exit 1; }
else
    echo "Scanning for adb..."
    roots=("$HOME" /opt /usr/lib /usr/local /snap/*/current/)
    mapfile -t found < <(
        { for v in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}"; do [ -n "$v" ] && echo "$v"; done
          command -v adb 2>/dev/null || true
          find "${roots[@]}" -maxdepth 7 -type f -name adb -path '*platform-tools/adb' 2>/dev/null || true
        } | while read -r a; do sdk_root_of "$a" || true; done
    )

    sdks=(); seen=" "
    for s in "${found[@]}"; do
        r=$(readlink -f "$s")
        [[ "$seen" == *" $r "* ]] && continue
        seen+="$r "; sdks+=("$s")
    done

    if [ ${#sdks[@]} -eq 0 ]; then
        echo "adb not found. Install platform-tools via Android Studio SDK Manager, or pass the path: bi-adb-fix /path/to/sdk" >&2
        exit 1
    fi

    cur=$(readlink -f "${ANDROID_HOME:-/nonexistent}" 2>/dev/null || true)
    def=1
    echo ""
    for i in "${!sdks[@]}"; do
        v=$("${sdks[$i]}/platform-tools/adb" version 2>/dev/null | sed -n 's/^Version //p' | head -1)
        mark=""; [ "$(readlink -f "${sdks[$i]}")" = "$cur" ] && { mark="  <- current"; def=$((i + 1)); }
        printf "  %2d) adb %-12s %s%s\n" "$((i + 1))" "${v:-?}" "${sdks[$i]}" "$mark"
    done
    echo ""
    read -rp "Choose SDK [$def]: " n </dev/tty
    n=${n:-$def}
    [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#sdks[@]} ] || { echo "Invalid choice" >&2; exit 1; }
    SDK="${sdks[$((n - 1))]}"
fi

echo "Android SDK: $SDK"
"$SDK/platform-tools/adb" version | head -1

touch "$EXPORTS"
cp "$EXPORTS" "$EXPORTS.bak"

# Drop previous managed block and any stray ANDROID_HOME / ANDROID_SDK_ROOT / platform-tools lines.
tmp=$(mktemp)
awk -v b="$BEGIN" -v e="$END" '
    $0 == b {skip=1; next}
    $0 == e {skip=0; next}
    skip {next}
    /^[[:space:]]*export[[:space:]]+(ANDROID_HOME|ANDROID_SDK_ROOT)=/ {next}
    /^[[:space:]]*export[[:space:]]+PATH=.*platform-tools/ {next}
    {print}
' "$EXPORTS" > "$tmp"

{
    sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp"   # strip trailing blank lines
    echo ""
    echo "$BEGIN"
    echo "export ANDROID_HOME=\"$SDK\""
    echo "export ANDROID_SDK_ROOT=\"\$ANDROID_HOME\""
    echo "export PATH=\"\$ANDROID_HOME/platform-tools:\$PATH\""
    [ -d "$SDK/emulator" ] && echo "export PATH=\"\$ANDROID_HOME/emulator:\$PATH\""
    [ -d "$SDK/cmdline-tools/latest/bin" ] && echo "export PATH=\"\$ANDROID_HOME/cmdline-tools/latest/bin:\$PATH\""
    echo "$END"
} > "$EXPORTS"
rm -f "$tmp"

echo "Updated $EXPORTS (backup: $EXPORTS.bak)"
echo "Run: source $EXPORTS   (or open a new terminal)"
