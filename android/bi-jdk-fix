#!/usr/bin/env bash
# bi: Find installed JDKs, pick one and export JAVA_HOME
# bi-arg: @dir
# Scan the system for JDKs, let you pick one, and write a managed JAVA_HOME
# block into ~/.me/exports.local so java/javac are available in every terminal.
# Usage: bi-jdk-fix [path-to-jdk-or-java]   (no arg: scan and choose)
set -euo pipefail

EXPORTS="$HOME/.me/exports.local"   # machine-specific, not in git; loaded by ~/.me/exports
BEGIN="# >>> bi-jdk-fix >>>"
END="# <<< bi-jdk-fix <<<"

# Resolve a JDK home from a path that may be the JDK, its bin dir, or the java binary.
jdk_home_of() {
    local p="$1"
    [ -e "$p" ] || return 1
    [ -L "$p" ] && p=$(readlink -f "$p")   # e.g. /usr/bin/java -> real jdk
    [ -f "$p" ] && p=$(dirname "$p")
    [ "$(basename "$p")" = "bin" ] && p=$(dirname "$p")
    [ -x "$p/bin/java" ] && echo "$p"
}

if [ $# -gt 0 ]; then
    JDK=$(jdk_home_of "$1") || { echo "No JDK found at: $1" >&2; exit 1; }
else
    echo "Scanning for JDKs..."
    roots=("$HOME" /opt /usr/lib/jvm /usr/local /snap/*/current/)
    mapfile -t found < <(
        { [ -n "${JAVA_HOME:-}" ] && echo "$JAVA_HOME/bin/java"
          command -v java 2>/dev/null || true
          find "${roots[@]}" -maxdepth 7 -type f -name java -path '*/bin/java' 2>/dev/null || true
        } | while read -r j; do
            h=$(jdk_home_of "$j") || continue
            # skip the nested jre/ inside an old JDK 8
            [ "$(basename "$h")" = "jre" ] && [ -x "$(dirname "$h")/bin/java" ] && continue
            echo "$h"
        done
    )

    # dedupe by real path, keep the first (friendliest) spelling
    jdks=(); seen=" "
    for h in "${found[@]}"; do
        r=$(readlink -f "$h")
        [[ "$seen" == *" $r "* ]] && continue
        seen+="$r "; jdks+=("$h")
    done

    if [ ${#jdks[@]} -eq 0 ]; then
        echo "No JDK found. Install one (e.g. sudo apt install openjdk-17-jdk) or pass a path: bi-jdk-fix /path/to/jdk" >&2
        exit 1
    fi

    cur=$(readlink -f "${JAVA_HOME:-/nonexistent}" 2>/dev/null || true)
    def=1
    echo ""
    for i in "${!jdks[@]}"; do
        v=$("${jdks[$i]}/bin/java" -version 2>&1 | head -1 | sed 's/^[^"]*"\([^"]*\)".*/\1/')
        javac=""; [ -x "${jdks[$i]}/bin/javac" ] || javac="  (JRE only, no javac)"
        mark=""; [ "$(readlink -f "${jdks[$i]}")" = "$cur" ] && { mark="  <- current"; def=$((i + 1)); }
        printf "  %2d) %-10s %s%s%s\n" "$((i + 1))" "$v" "${jdks[$i]}" "$javac" "$mark"
    done
    echo ""
    read -rp "Choose JDK [$def]: " n </dev/tty
    n=${n:-$def}
    [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#jdks[@]} ] || { echo "Invalid choice" >&2; exit 1; }
    JDK="${jdks[$((n - 1))]}"
fi

echo "JDK: $JDK"
"$JDK/bin/java" -version 2>&1 | head -1

touch "$EXPORTS"
cp "$EXPORTS" "$EXPORTS.bak"

# Drop previous managed block and any stray JAVA_HOME lines.
tmp=$(mktemp)
awk -v b="$BEGIN" -v e="$END" '
    $0 == b {skip=1; next}
    $0 == e {skip=0; next}
    skip {next}
    /^[[:space:]]*export[[:space:]]+JAVA_HOME=/ {next}
    /^[[:space:]]*export[[:space:]]+PATH=.*JAVA_HOME/ {next}
    /^# Java JDK[[:space:]]*$/ {next}
    {print}
' "$EXPORTS" > "$tmp"

{
    sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp"   # strip trailing blank lines
    echo ""
    echo "$BEGIN"
    echo "export JAVA_HOME=\"$JDK\""
    echo "export PATH=\"\$JAVA_HOME/bin:\$PATH\""
    echo "$END"
} > "$EXPORTS"
rm -f "$tmp"

echo "Updated $EXPORTS (backup: $EXPORTS.bak)"
echo "Run: source $EXPORTS   (or open a new terminal)"
